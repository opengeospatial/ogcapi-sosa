      "itemIdentifier": "ogc.sosa",
      "name": "Sensor, Observation, Sample, and Actuator (SOSA)",
      "abstract": "The SOSA (Sensor, Observation, Sample, and Actuator) ontology  is a realisation of the Observations, Measurements and Sampling (OMS) Conceptual model. See the `oms-alignment` building block for the class-by-class mapping to ISO 19156:2023.",
      "status": "under-development",
      "dateTimeAddition": "2023-04-13T00:00:00Z",
