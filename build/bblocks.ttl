        <bblocks://ogc.sosa.features.observation>,
        <bblocks://ogc.sosa.features.observationCollection>,
        <bblocks://ogc.sosa.features.platform>,
        <bblocks://ogc.sosa.features.sample>,
        <bblocks://ogc.sosa.features.sampleCollection>,
        <bblocks://ogc.sosa.features.sampler>,
        <bblocks://ogc.sosa.features.sampling>,
        <bblocks://ogc.sosa.features.samplingCollection>,
        <bblocks://ogc.sosa.features.sensor>,
        <bblocks://ogc.sosa.features.system>,
        <bblocks://ogc.sosa.oms-alignment>,
        <bblocks://ogc.sosa.properties.actuation>,
        <bblocks://ogc.sosa.properties.actuationCollection>,
        <bblocks://ogc.sosa.properties.actuator>,
        <bblocks://ogc.sosa.properties.asset>,
        <bblocks://ogc.sosa.properties.deployment>,
        <bblocks://ogc.sosa.properties.execution>,
