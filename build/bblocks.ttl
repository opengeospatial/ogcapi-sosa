            prof:hasRole role:schema ] ;
    prof:isProfileOf <bblocks://ogc.sosa.features.system> ;
    bblocks:dependsOn <bblocks://ogc.sosa.features.system>,
        <bblocks://ogc.sosa.properties.actuator> ;
    bblocks:scope <http://www.opengis.net/def/bblocks/scope/development> ;
    bblocks:status <http://www.opengis.net/def/status/under-development> ;
    bblocks:validationPassed true .

