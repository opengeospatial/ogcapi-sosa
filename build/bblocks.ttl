<bblocks://ogc.sosa> a skos:Concept,
        dcat:Dataset,
        bblocks:Api,
        bblocks:BBlock ;
    rdfs:label "Sensor, Observation, Sample, and Actuator (SOSA)" ;
    dct:abstract "The SOSA (Sensor, Observation, Sample, and Actuator) ontology  is a realisation of the Observations, Measurements and Sampling (OMS) Conceptual model. See the `oms-alignment` building block for the class-by-class mapping to ISO 19156:2023."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2023-04-13T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://opengeospatial.github.io/ogcapi-sosa/bblock/ogc.sosa> ],
        [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://opengeospatial.github.io/ogcapi-sosa/build/generateddocs/json-full/sosa/index.json> ],
        [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://opengeospatial.github.io/ogcapi-sosa/build/generateddocs/markdown/sosa/index.md> ] ;
    dct:hasVersion "1.0" ;
    dct:modified "2026-09-10"^^xsd:date ;
    dct:source <https://www.w3.org/TR/vocab-ssn/> ;
    skos:inScheme <https://opengeospatial.github.io/ogcapi-sosa/> ;
    skos:prefLabel "Sensor, Observation, Sample, and Actuator (SOSA)" ;
    skos:topConceptOf <https://opengeospatial.github.io/ogcapi-sosa/> ;
    dcat:keyword "o&m",
        "o&m&s",
        "sosa",
        "ssn" ;
    bblocks:scope <http://www.opengis.net/def/bblocks/scope/development> ;
    bblocks:status <http://www.opengis.net/def/status/under-development> ;
    bblocks:validationPassed true .

<bblocks://ogc.sosa.features.actuationCollection> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "ActuationCollection Feature" ;
    dct:abstract "OMS alignment: `sosa:ActuationCollection` is a SOSA/SSN generalization with no direct ISO 19156 (OMS) counterpart, since actuation is outside the scope of O&M/OMS, which standardizes observation and sampling only; see the OMS alignment building block (`ogc.sosa.oms-alignment`). This building block defines the set of a GeoJSON FeatureCollection containing a SOSA ActuationCollection - a collection of one or more Actuations, whose members share a common value for one or more properties."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-08-29T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://opengeospatial.github.io/ogcapi-sosa/build/generateddocs/json-full/sosa/features/actuationCollection/index.json> ],
        [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://opengeospatial.github.io/ogcapi-sosa/build/generateddocs/markdown/sosa/features/actuationCollection/index.md> ],
        [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://opengeospatial.github.io/ogcapi-sosa/bblock/ogc.sosa.features.actuationCollection> ] ;
    dct:hasVersion "1.0" ;
    dct:modified "2026-09-10"^^xsd:date ;
    dct:source <https://www.w3.org/TR/vocab-ssn/> ;
    rdfs:subClassOf sosa:ActuationCollection ;
    skos:inScheme <https://opengeospatial.github.io/ogcapi-sosa/> ;
    skos:prefLabel "ActuationCollection Feature" ;
    skos:topConceptOf <https://opengeospatial.github.io/ogcapi-sosa/> ;
    dcat:keyword "actuation",
        "collection",
        "o&m",
        "sosa",
        "ssn" ;
    prof:hasResource [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.geo.features.feature> ;
            prof:hasArtifact <https://opengeospatial.github.io/bblocks/registereditems/geo/features/feature/shapes.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.geo.features.featureCollection> ;
            prof:hasArtifact <https://opengeospatial.github.io/bblocks/registereditems/geo/features/featureCollection/shapes.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo <https://json-schema.org/draft/2020-12/schema> ;
            dct:format "application/json" ;
            prof:hasArtifact <https://opengeospatial.github.io/ogcapi-sosa/build/annotated/sosa/features/actuationCollection/schema.json> ;
            prof:hasRole role:schema ],
        [ dct:conformsTo <https://www.w3.org/TR/json-ld11/> ;
            dct:format "application/ld+json" ;
            prof:hasArtifact <https://opengeospatial.github.io/ogcapi-sosa/build/annotated/sosa/features/actuationCollection/context.jsonld> ;
            prof:hasRole role:mapping ],
        [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.sosa.properties.execution> ;
            prof:hasArtifact <https://opengeospatial.github.io/ogcapi-sosa/_sources/properties/execution/shapes.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo <https://json-schema.org/draft/2020-12/schema> ;
            dct:format "application/yaml" ;
            prof:hasArtifact <https://opengeospatial.github.io/ogcapi-sosa/build/annotated/sosa/features/actuationCollection/schema.yaml> ;
            prof:hasRole role:schema ] ;
    prof:isProfileOf <bblocks://ogc.sosa.features.executionCollection> ;
