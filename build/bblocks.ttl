    dct:source <https://www.w3.org/TR/vocab-ssn/> ;
    rdfs:subClassOf sosa:System ;
    skos:inScheme <https://opengeospatial.github.io/ogcapi-sosa/> ;
    skos:prefLabel "System Feature" ;
    skos:topConceptOf <https://opengeospatial.github.io/ogcapi-sosa/> ;
    dcat:keyword "o&m",
        "sosa",
        "ssn",
        "system" ;
    prof:hasResource [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.geo.features.feature> ;
            prof:hasArtifact <https://opengeospatial.github.io/bblocks/registereditems/geo/features/feature/shapes.shacl> ;
