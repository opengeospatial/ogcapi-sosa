            prof:hasArtifact <https://opengeospatial.github.io/ogcapi-sosa/build/annotated/sosa/features/system/schema.yaml> ;
            prof:hasRole role:schema ],
        [ dct:conformsTo <https://www.w3.org/TR/json-ld11/> ;
            dct:format "application/ld+json" ;
