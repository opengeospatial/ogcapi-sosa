            prof:hasRole role:schema ],
        [ dct:conformsTo <https://json-schema.org/draft/2020-12/schema> ;
            dct:format "application/json" ;
            prof:hasArtifact <https://opengeospatial.github.io/ogcapi-sosa/build/annotated/sosa/features/platform/schema.json> ;
