            prof:hasRole role:schema ] ;
    prof:isProfileOf <bblocks://ogc.sosa.features.asset> ;
    bblocks:dependsOn <bblocks://ogc.sosa.features.asset>,
        <bblocks://ogc.sosa.properties.system> ;
