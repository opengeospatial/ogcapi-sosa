        <bblocks://ogc.sosa.properties.actuationCollection> ;
    bblocks:scope <http://www.opengis.net/def/bblocks/scope/development> ;
    bblocks:status <http://www.opengis.net/def/status/under-development> ;
    bblocks:validationPassed true .

<bblocks://ogc.sosa.features.actuator> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "Actuator Feature" ;
    dct:abstract "OMS alignment: `sosa:Actuator` is a SOSA/SSN generalization with no direct ISO 19156 (OMS) counterpart, since actuation is outside the scope of O&M/OMS, which standardizes observation and sampling only; see the OMS alignment building block (`ogc.sosa.oms-alignment`). This building block defines a GeoJSON feature for a SOSA Actuator - a System that is used by, or implements, an Actuating Procedure that changes the state of the world. Uses the properties defined in the Actuator Properties schema."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-08-29T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://opengeospatial.github.io/ogcapi-sosa/bblock/ogc.sosa.features.actuator> ],
        [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://opengeospatial.github.io/ogcapi-sosa/build/generateddocs/markdown/sosa/features/actuator/index.md> ],
        [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://opengeospatial.github.io/ogcapi-sosa/build/generateddocs/json-full/sosa/features/actuator/index.json> ] ;
    dct:hasVersion "1.0" ;
    dct:modified "2026-09-10"^^xsd:date ;
    dct:source <https://www.w3.org/TR/vocab-ssn/> ;
    rdfs:subClassOf sosa:Actuator ;
    skos:inScheme <https://opengeospatial.github.io/ogcapi-sosa/> ;
    skos:prefLabel "Actuator Feature" ;
    skos:topConceptOf <https://opengeospatial.github.io/ogcapi-sosa/> ;
    dcat:keyword "actuator",
        "o&m",
        "sosa",
        "ssn",
        "system" ;
    prof:hasResource [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.geo.features.feature> ;
            prof:hasArtifact <https://opengeospatial.github.io/bblocks/registereditems/geo/features/feature/shapes.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo <https://www.w3.org/TR/json-ld11/> ;
            dct:format "application/ld+json" ;
            prof:hasArtifact <https://opengeospatial.github.io/ogcapi-sosa/build/annotated/sosa/features/actuator/context.jsonld> ;
            prof:hasRole role:mapping ],
        [ dct:conformsTo <https://json-schema.org/draft/2020-12/schema> ;
            dct:format "application/yaml" ;
