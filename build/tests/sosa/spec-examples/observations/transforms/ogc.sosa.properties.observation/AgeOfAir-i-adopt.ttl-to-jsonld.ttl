@prefix P21: <http://vocab.nerc.ac.uk/collection/P21/current/> .
@prefix et: <http://vocabs.lter-europe.net/EnvThes/> .
@prefix ex: <https://example.org/data/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix sweet: <http://sweetontology.net/realmCryo/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Ob873t2 a sosa:Observation ;
    sosa:hasFeatureOfInterest ex:Bubble873 ;
    sosa:hasResult [ a qudt:QuantityValue ;
            qudt:hasUnit unit:YR ;
            qudt:value 7530.0 ] ;
    sosa:hasUltimateFeatureOfInterest ex:EarthAtmosphere ;
    sosa:observedProperty ex:AgeOfAir ;
    sosa:resultTime "2018-01-09T14:15:00+00:00"^^xsd:dateTime ;
    sosa:usedProcedure ex:C14 .

sweet:IceCore a iop:Entity ;
    rdfs:label "ice core" .

et:21590 a iop:Property ;
    rdfs:label "age" .

et:23 a iop:Entity ;
    rdfs:label "air" .

ex:AgeOfAir a sosa:Property,
        iop:Variable ;
    skos:broadMatch <http://vocab.nerc.ac.uk/collection/S06/current/S0600001/> ;
    skos:definition "The age of air gas in ice core." ;
    skos:prefLabel "AgeOfAir" ;
    iop:hasMatrix sweet:IceCore ;
    iop:hasObjectOfInterest et:23 ;
    iop:hasProperty et:21590 .

ex:Antarctic_ice_sheet a sosa:FeatureOfInterest,
        <https://www.wikidata.org/wiki/Q571430> .

ex:Bubble873 a sosa:MaterialSample,
        sosa:Sample ;
    sosa:isResultOf ex:CoreEx1923 ;
    sosa:isSampleOf ex:EarthAtmosphere,
        ex:IceCore12 ;
    sosa:isSampleOfUltimateFOI ex:Antarctic_ice_sheet .

ex:EarthAtmosphere a P21:MS292,
        sosa:FeatureOfInterest .

