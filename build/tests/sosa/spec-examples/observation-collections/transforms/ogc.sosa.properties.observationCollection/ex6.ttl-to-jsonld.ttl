@prefix ex: <https://example.org/data/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .

ex:TemperatureSensorOperatingRange a sosa:ObservationCollection,
        sosa:OperatingConditions ;
    sosa:hasMember ex:NormalHumidityCondition,
        ex:NormalTemperatureCondition ;
    sosa:observedProperty <https://example.org/closure/ex6-humidity>,
        <https://example.org/closure/ex6-temperature> .

