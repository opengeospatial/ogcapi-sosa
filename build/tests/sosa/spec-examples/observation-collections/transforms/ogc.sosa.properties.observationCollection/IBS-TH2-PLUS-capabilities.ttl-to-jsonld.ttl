@prefix ex: <https://example.org/data/> .
@prefix qk: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sensor: <https://example.org/sensor/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sensor:IBS-TH2-Plus-T-normalHumidityConditions a sosa:Observation ;
    sosa:hasFeatureOfInterest ex:IBS-TH2-Plus-T-687343 ;
    sosa:hasMember [ a sosa:Observation ;
            sosa:hasResult [ qudt:hasUnit unit:PERCENT ;
                    qudt:value 99.0 ] ;
            sosa:observedProperty <http://www.w3.org/ns/sosa/system-environment-properties#MaxAmbientRelativeHumidity> ],
        [ a sosa:Observation ;
            sosa:hasResult [ qudt:hasUnit unit:PERCENT ;
                    qudt:value 0.0 ] ;
            sosa:observedProperty <http://www.w3.org/ns/sosa/system-environment-properties#MinAmbientRelativeHumidity> ] ;
    sosa:resultTime "2017-01-01T00:00:00+00:00"^^xsd:dateTime .

sensor:IBS-TH2-Plus-T-systemCapability a sosa:ObservationCollection ;
    sosa:hasFeatureOfInterest ex:IBS-TH2-Plus-T-687343 ;
    sosa:hasMember [ a sosa:Observation ;
            sosa:hasResult [ qudt:hasUnit unit:DEG_C ;
                    qudt:value -40.0 ] ;
            sosa:observedProperty <http://www.w3.org/ns/sosa/system-capability-properties#MinMeasurableTemperature> ],
        [ a sosa:Observation ;
            sosa:hasResult [ qudt:hasUnit unit:DEG_C ;
                    qudt:value 0.5 ] ;
            sosa:observedProperty <http://www.w3.org/ns/sosa/system-capability-properties#TemperatureAccuracy> ],
        [ a sosa:Observation ;
            sosa:hasResult [ qudt:hasUnit unit:DEG_C ;
                    qudt:value 60.0 ] ;
            sosa:observedProperty <http://www.w3.org/ns/sosa/system-capability-properties#MaxMeasurableTemperature> ] ;
    sosa:hasValidityContext sensor:IBS-TH2-Plus-T-normalHumidityConditions ;
    sosa:resultTime "2017-01-01T00:00:00+00:00"^^xsd:dateTime .

ex:IBS-TH2-Plus-T-687343 a sensor:IBS-TH2-Plus-T ;
    rdfs:label "IBS-TH2 PLUS Temperature Sensor instance 687343" ;
    sosa:hasSystemCapability sensor:IBS-TH2-Plus-T-systemCapability ;
    sosa:observes qk:Temperature .

