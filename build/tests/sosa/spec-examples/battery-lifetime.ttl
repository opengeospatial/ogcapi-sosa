@prefix ex: <http://example.org/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sosa-cap: <http://www.w3.org/ns/sosa/system-capability-properties#> .
@prefix sosa1: <https://www.w3.org/TR/vocab-ssn/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix uom: <http://www.ontology-of-units-of-measure.org/resource/om-2/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:nominalLifetime a sosa1:Observation ;
    sosa1:hasFeatureOfInterest ex:sensor ;
    sosa1:hasResult [ qudt:hasUnit unit:YR ;
            qudt:value 1.0 ] ;
    sosa1:observedProperty ex:nominalLifetimeRestriction .

ex:nominalLifetimeRestriction a iop:Variable,
        sosa1:Property ;
    iop:hasObjectOfInterest ex:AABattery ;
    iop:hasProperty sosa-cap:BatteryLifetime ;
    iop:hasStatisticalModifier uom:average .

ex:sensor a sosa1:Sensor ;
    sosa1:hasSubSystem ex:AABattery .

ex:AABattery a sosa1:Battery ;
    rdfs:label "An AA battery." .

