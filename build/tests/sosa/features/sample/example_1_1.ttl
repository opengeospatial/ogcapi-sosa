@prefix geojson: <https://purl.org/geojson/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/data/EarthAtmosphere_StE> a geojson:Feature ;
    sosa:isResultOf <https://example.org/data/AirSampling_StE> ;
    sosa:isSampleOf <https://example.org/data/EarthAtmosphere> ;
    geojson:geometry [ a geojson:Point ;
            geojson:coordinates ( 4.387611e+00 4.543777e+01 ) ] .

