@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] sosa:hasFeatureOfInterest <https://example.org/rooms/1> ;
    sosa:hasMember [ a sosa:Observation ;
            sosa:hasSimpleResult 2.73e+01 ;
            sosa:phenomenonTime "2022-05-03T20:33:40+00:00"^^xsd:dateTime ],
        [ a sosa:Observation ;
            sosa:hasSimpleResult 2.41e+01 ;
            sosa:phenomenonTime "2022-05-01T20:33:40+00:00"^^xsd:dateTime ] ;
    sosa:observedProperty <http://qudt.org/vocab/quantitykind/Temperature> ;
    sosa:phenomenonTime [ a time:Interval ;
            time:hasBeginning [ time:inXSDDateTime "2022-05-03T00:00:00+00:00"^^xsd:dateTime ] ;
            time:hasEnd [ time:inXSDDateTime "2022-05-03T23:59:59+00:00"^^xsd:dateTime ] ],
        [ a time:Interval ;
            time:hasBeginning [ time:inXSDDateTime "2022-05-01T00:00:00+00:00"^^xsd:dateTime ] ;
            time:hasEnd [ time:inXSDDateTime "2022-05-01T23:59:59+00:00"^^xsd:dateTime ] ] .

