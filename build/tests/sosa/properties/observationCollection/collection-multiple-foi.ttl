@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] sosa:hasFeatureOfInterest <https://example.org/rooms/1>,
        <https://example.org/rooms/2> ;
    sosa:hasMember [ a sosa:Observation ;
            sosa:hasFeatureOfInterest <https://example.org/rooms/1> ;
            sosa:hasSimpleResult 2.41e+01 ;
            sosa:resultTime "2022-05-01T20:33:40+00:00"^^xsd:dateTime ],
        [ a sosa:Observation ;
            sosa:hasFeatureOfInterest <https://example.org/rooms/2> ;
            sosa:hasSimpleResult 2.73e+01 ;
            sosa:resultTime "2022-05-01T22:33:40+00:00"^^xsd:dateTime ] ;
    sosa:madeBySensor <https://example.org/sensors/T56> ;
    sosa:observedProperty <http://qudt.org/vocab/quantitykind/Temperature> .

