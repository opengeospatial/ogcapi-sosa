@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix closure: <https://example.org/closure/> .
@prefix ex: <https://example.org/data/> .
@prefix sensor: <https://example.org/sensor/> .

# SHACL closure (not part of the SOSA example): puts the example's executions in a collection that
# supplies the values they leave out, which they inherit by SOSA collection rule 2. closure: IRIs
# and the 2017-01-01 time are placeholders.

# the sensor type's capabilities and conditions describe the sensor instance
closure:IBS-TH2-PLUS-characteristics a sosa:ObservationCollection ;
    sosa:hasFeatureOfInterest ex:IBS-TH2-Plus-T-687343 ;
    sosa:resultTime "2017-01-01T00:00:00Z"^^xsd:dateTime ;
    sosa:hasMember sensor:IBS-TH2-Plus-T-systemCapability, sensor:IBS-TH2-Plus-T-normalHumidityConditions .
