@base <https://w3c.github.io/sdw-sosa-ssn/ssn/rdf/examples/ex6.ttl> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix closure: <https://example.org/closure/> .
@prefix ex: <https://example.org/data/> .

# SHACL closure (not part of the SOSA example): puts the example's executions in a collection that
# supplies the values they leave out, which they inherit by SOSA collection rule 2, and gives the
# example's resources the values that can't be inherited. closure: IRIs and the 2017-01-01 time
# are placeholders. The example uses relative IRIs, which resolve against its URL (@base).

closure:ex6-observations a sosa:ObservationCollection ;
    sosa:hasFeatureOfInterest closure:ex6-feature ;
    sosa:observedProperty closure:ex6-temperature ;
    sosa:resultTime "2017-01-01T00:00:00Z"^^xsd:dateTime ;
    sosa:hasMember <Observation/1> , <Observation/2> .

# results can't be inherited
<Observation/1> sosa:hasResult closure:ex6-result-1 .
<Observation/2> sosa:hasResult closure:ex6-result-2 .

# the operating range's conditions (its members) are for temperature and humidity
ex:TemperatureSensorOperatingRange sosa:observedProperty closure:ex6-temperature , closure:ex6-humidity .
