@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix closure: <https://example.org/closure/> .
@prefix ex: <https://example.org/data/> .

# SHACL closure (not part of the SOSA example): puts the example's executions in a collection that
# supplies the values they leave out, which they inherit by SOSA collection rule 2. closure: IRIs
# and the 2017-01-01 time are placeholders.

# the capability and operating-condition collections: a time only (members have their own
# features of interest, which the collection's would have to include)
closure:dht22-characteristics a sosa:ObservationCollection ;
    sosa:resultTime "2017-01-01T00:00:00Z"^^xsd:dateTime ;
    sosa:hasMember ex:DHT22_4578_HumiditySensorNormalOperatingConditions,
        ex:DHT22_4578_TemperatureSensorNormalOperatingConditions,
        ex:DHT22_4578_TemperatureSensorCapabilities, ex:DHT22_4578_HumiditySensorCapabilities .

closure:dht22-observations a sosa:ObservationCollection ;
    sosa:hasFeatureOfInterest closure:dht22-ambient-air ;
    sosa:resultTime "2017-01-01T00:00:00Z"^^xsd:dateTime ;
    sosa:hasMember ex:observation_1087 .
