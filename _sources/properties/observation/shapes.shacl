@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix geojson: <https://purl.org/geojson/vocab#> .
@prefix sosa:    <http://www.w3.org/ns/sosa/> .
@base <https://www.ogc.org/rules/sosa/> .

<#testObservedPropertyPresent>
    a                   sh:NodeShape ;
    sh:targetClass      sosa:Observation ;
    sh:targetSubjectsOf sosa:hasResult, sosa:hasSimpleResult ;
    # An observation needs an observedProperty: its own, or one provided by a collection it is a
    # (direct or transitive) member of (collection rule 2). Results of actuations and samplings
    # (typed, or recognisable by their properties or collection) don't make them observations.
    sh:sparql [
        sh:message          "sosa:observedProperty is required, on the observation or a collection it is a member of" ;
        sh:select """
            PREFIX sosa: <http://www.w3.org/ns/sosa/>
            PREFIX geojson: <https://purl.org/geojson/vocab#>
            SELECT $this (sosa:observedProperty AS ?path) WHERE {
                FILTER NOT EXISTS {
                    $this (^sosa:hasMember|^geojson:features|sosa:memberOf)* ?holder .
                    ?holder sosa:observedProperty ?prop .
                }
                FILTER (EXISTS { $this a sosa:Observation } || NOT EXISTS {
                    { $this a ?type . FILTER(?type IN (sosa:Actuation, sosa:Sampling)) }
                    UNION
                    { $this sosa:actsOnProperty|sosa:madeByActuator|sosa:madeBySampler ?x }
                    UNION
                    {
                        $this (^sosa:hasMember|^geojson:features|sosa:memberOf)+ ?collection .
                        ?collection a ?ctype .
                        FILTER(?ctype IN (sosa:ActuationCollection, sosa:SamplingCollection))
                    }
                })
            }
        """ ;
    ] ;
.

<#testObservedPropertyConsistent>
    a                   sh:NodeShape ;
    sh:targetClass      sosa:ObservationCollection;
    # A collection needs an observedProperty: its own, one inherited from a collection it is a
    # (direct or transitive) member of (collection rule 2), or its members' own or inherited ones
    # (a member may also belong to other collections). Whether members' values match the
    # collection's is checked by testCollectionPropertyValues.
    sh:sparql [
        sh:message          "sosa:observedProperty is required, on the collection, a collection it is a member of, or its members" ;
        sh:select """
            PREFIX sosa: <http://www.w3.org/ns/sosa/>
            PREFIX geojson: <https://purl.org/geojson/vocab#>
            SELECT $this (sosa:observedProperty AS ?path) WHERE {
                FILTER NOT EXISTS {
                    { $this (^sosa:hasMember|^geojson:features|sosa:memberOf)* ?holder }
                    UNION
                    {
                        $this (sosa:hasMember|geojson:features|^sosa:memberOf)+ ?member .
                        ?member (^sosa:hasMember|^geojson:features|sosa:memberOf)* ?holder .
                    }
                    ?holder sosa:observedProperty ?prop .
                }
            }
        """ ;
    ] ;
.

<#testResultNotEmptyNode>
    a                   sh:NodeShape ;
    sh:targetSubjectsOf sosa:hasResult-Disabled ;
    sh:message          "sosa:hasResult not a blank node" ;
    sh:sparql           [ sh:select """
      PREFIX geojson: <https://purl.org/geojson/vocab#>
      SELECT $this (sosa:hasResult as ?path) ?value
      WHERE {
        $this sosa:hasResult ?value .
        FILTER NOT EXISTS { ?value ?p ?o }
      }
    """ ; ]
.
