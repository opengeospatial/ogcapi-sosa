@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix geojson: <https://purl.org/geojson/vocab#> .
@prefix sosa:    <http://www.w3.org/ns/sosa/> .
@base <https://www.ogc.org/rules/sosa/> .

<#SOSA-testRequiredTime>
    a                   sh:NodeShape ;
    sh:targetClass      sosa:Observation ;
    sh:targetSubjectsOf sosa:hasResult, sosa:hasSimpleResult ;
    sh:message          "SOSA-testRequiredTime: sosa:time sosa:resultTime or sosa:phenomenonTime is required, at Collection or Observation" ;
    sh:or               ( [ sh:path     ( [ sh:zeroOrMorePath [ sh:oneOrMorePath [ sh:inversePath sosa:hasMember ] ] ]
                                          sosa:phenomenonTime ) ;
                            sh:minCount 1 ;
                             ] [ sh:path     ( [ sh:zeroOrMorePath [ sh:oneOrMorePath [ sh:inversePath
                                                                                                               geojson:features ] ] ]
                                                              sosa:phenomenonTime ) ;
                                                sh:minCount 1 ;
                                                ] [ sh:path     ( [ sh:zeroOrMorePath [ sh:oneOrMorePath
                                                                                                                [ sh:inversePath
                                                                                                                          sosa:hasMember ] ] ]
                                                                                  sosa:resultTime ) ;
                                                                    sh:minCount 1 ;
                                                                     ] [ sh:path     ( [ sh:zeroOrMorePath
                                                                                                                [ sh:oneOrMorePath
                                                                                                                          [ sh:inversePath
                                                                                                                                    geojson:features ] ] ]
                                                                                                      sosa:resultTime ) ;
                                                                                        sh:minCount 1 ;
                                                                                         ] ) ;
.

<#SOSA-testObservedProperty>
    a                   sh:NodeShape ;
    sh:targetClass      sosa:Observation ;
    sh:targetSubjectsOf sosa:hasResult, sosa:hasSimpleResult ;
    # Note observed properties may be listed in Collections
    # 3. Where an individual ObservationCollection has more than one value for a property, each member Observation (direct or transitive) MUST have a value for that property that matches one of the values for the property in the collection.
    sh:message          "SOSA-testObservedProperty: At least 1 of sosa:observedProperty is required in Observation or parent Collection" ;
    sh:property         [ sh:path     ( [ sh:zeroOrMorePath [ sh:oneOrMorePath [ sh:alternativePath ( [ sh:inversePath
                                                                                                                geojson:features ]
                                                                                                      [ sh:inversePath
                                                                                                                sosa:hasMember ] ) ] ] ]
                                        sosa:observedProperty ) ;
                          sh:minCount 1 ;
                          ] ;
.


<#SOSA-testFeatureOfInterestPresent>
    a                   sh:NodeShape ;
    sh:targetClass      sosa:Observation ;
    sh:targetSubjectsOf sosa:hasResult, sosa:hasSimpleResult ;
    sh:property         [ sh:path     ( [ sh:zeroOrMorePath [ sh:oneOrMorePath [ sh:alternativePath ( [ sh:inversePath
                                                                                                                geojson:features ]
                                                                                                      [ sh:inversePath
                                                                                                                sosa:hasMember ] ) ] ] ]
                                        [ sh:alternativePath ( sosa:hasFeatureOfInterest [ sh:inversePath
                                                                                                   sosa:isFeatureOfInterestOf ] ) ] ) ;
                          sh:minCount 1 ;
                          sh:maxCount 1 ; ] ;
    sh:message          "SOSA-testFeatureOfInterest: Exactly one feature of interest (sosa:hasFeatureOfInterest/sosa:isFeatureOfInterestOf) is required" ;
.

<#SOSA-testFeatureOfInterestSingular>
    a                   sh:NodeShape ;
    sh:targetSubjectsOf sosa:hasFeatureOfInterest ;
    sh:property         [ sh:path sosa:hasFeatureOfInterest ;
                          sh:maxCount 1 ; ] ;
    sh:message          "SOSA-testFeatureOfInterest: Only one feature of interest (sosa:hasFeatureOfInterest/sosa:isFeatureOfInterestOf) is allowed for an Observation" ;
.

<#SOSA-testResult>
    a                   sh:NodeShape ;
    sh:targetClass      sosa:Observation ;
    sh:targetSubjectsOf sosa:hasResult, sosa:hasSimpleResult ;
    sh:property         [ sh:path     [ sh:alternativePath ( sosa:hasResult sosa:hasSimpleResult ) ] ;
                          sh:minCount 1 ;
                          sh:maxCount 1 ; ] ;
    sh:message          "SOSA-testResult: Exactly one of sosa:hasResult or sosa:hasSimpleResult is required per observation" ;
.


<#SOSA-testSimpleResultLiteral>
    a                  sh:NodeShape ;
    sh:targetObjectsOf sosa:hasSimpleResult ;
    sh:nodeKind        sh:IRIOrLiteral ;
    sh:message         "SOSA-testSimpleResultLiteral: sosa:hasSimpleResult is a simple Literal" ;
.

<#SOSA-testResultNotEmptyNode>
    a                   sh:NodeShape ;
    sh:targetSubjectsOf sosa:hasResult-Disabled ;
    sh:message          "SOSA-testResultNotEmptyNode: sosa:hasResult not a blank node" ;
    sh:sparql           [ sh:select """
      PREFIX geojson: <https://purl.org/geojson/vocab#>
      SELECT $this (sosa:hasResult as ?path) ?value
      WHERE {
        $this sosa:hasResult ?value .
        FILTER NOT EXISTS { ?value ?p ?o }
      }
    """ ; ]
.
