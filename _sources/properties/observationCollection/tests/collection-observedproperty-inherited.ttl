@prefix ex: <https://example.org/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# The nested collection ex:c2 and its member inherit observedProperty from ex:c (collection rule 2)
ex:c a sosa:ObservationCollection ;
    sosa:hasFeatureOfInterest ex:f ;
    sosa:observedProperty ex:t ;
    sosa:resultTime "2022-05-01T22:33:44+00:00"^^xsd:dateTime ;
    sosa:hasMember ex:c2 .

ex:c2 a sosa:ObservationCollection ;
    sosa:hasMember ex:o1 .

ex:o1 a sosa:Observation ;
    sosa:hasSimpleResult 1 .
