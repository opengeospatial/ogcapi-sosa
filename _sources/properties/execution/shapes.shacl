@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix geojson: <https://purl.org/geojson/vocab#> .
@prefix sosa:    <http://www.w3.org/ns/sosa/> .
@base <https://www.ogc.org/rules/sosa/> .

<#testRequiredTime>
    a                   sh:NodeShape ;
    sh:targetClass      sosa:Observation, sosa:Actuation, sosa:Sampling ;
    sh:targetSubjectsOf sosa:hasResult, sosa:hasSimpleResult ;
    # A time is required: the execution's own, or one provided by a collection it is a (direct or
    # transitive) member of (collection rule 2).
    sh:sparql [
        sh:message          "One of sosa:resultTime, sosa:phenomenonTime, sosa:startTime or sosa:endTime is required, on the execution or a collection it is a member of" ;
        sh:select """
            PREFIX sosa: <http://www.w3.org/ns/sosa/>
            PREFIX geojson: <https://purl.org/geojson/vocab#>
            SELECT $this WHERE {
                FILTER NOT EXISTS {
                    $this (^sosa:hasMember|^geojson:features|sosa:memberOf)* ?holder .
                    ?holder sosa:resultTime|sosa:phenomenonTime|sosa:startTime|sosa:endTime ?time .
                }
            }
        """ ;
    ] ;
    # An execution has at most one resultTime and one phenomenonTime. Its value is its own, or else
    # the value(s) of the nearest collection that has the property: a collection's value applies
    # to a member that omits it only if the collection has a single value (rule 2). Where the
    # collection has several values or intervals (rules 3 and 5), the member must give its own.
    sh:sparql [
        sh:message          "At most one {?path} is allowed. A member of a collection with several {?path} values must give its own: {?value}" ;
        sh:select """
            PREFIX sosa: <http://www.w3.org/ns/sosa/>
            PREFIX geojson: <https://purl.org/geojson/vocab#>
            SELECT $this ?path (CONCAT(STR(COUNT(DISTINCT ?time)), ' values') AS ?value) WHERE {
                {
                    $this ?path ?time .
                    FILTER(?path IN (sosa:resultTime, sosa:phenomenonTime))
                } UNION {
                    # Binding ?path first (rather than filtering it afterwards) means the costly
                    # "nearer" test below runs only for time values, not for every property of the
                    # collection (e.g. all its features). VALUES is not allowed in SHACL-SPARQL.
                    { BIND(sosa:resultTime AS ?path) } UNION { BIND(sosa:phenomenonTime AS ?path) }
                    ?holder (sosa:hasMember|geojson:features|^sosa:memberOf)+ $this ;
                        ?path ?time .
                    FILTER NOT EXISTS { $this ?path ?own }
                    FILTER NOT EXISTS {
                        ?holder (sosa:hasMember|geojson:features|^sosa:memberOf)+ ?nearer .
                        ?nearer (sosa:hasMember|geojson:features|^sosa:memberOf)+ $this ;
                            ?path ?nearerTime .
                    }
                }
            }
            GROUP BY $this ?path
            HAVING (COUNT(DISTINCT ?time) > 1)
        """ ;
    ] ;
.

<#testFeatureOfInterest>
    a                   sh:NodeShape ;
    sh:targetClass      sosa:Observation, sosa:Actuation, sosa:Sampling ;
    sh:targetSubjectsOf sosa:hasResult, sosa:hasSimpleResult ;
    sh:property         [
        sh:message          "Feature of interest (sosa:hasFeatureOfInterest/sosa:isFeatureOfInterestOf) is required in Collection or Execution(Observation/Actuation/Sampling)" ;
        sh:path     ( [ sh:zeroOrMorePath [ sh:oneOrMorePath [ sh:alternativePath ( [ sh:inversePath
                                                                                                                geojson:features ]
                                                                                                      [ sh:inversePath
                                                                                                                sosa:hasMember ] ) ] ] ]
                                        [ sh:alternativePath ( sosa:hasFeatureOfInterest [ sh:inversePath
                                                                                                   sosa:isFeatureOfInterestOf ] ) ] ) ;
                          sh:minCount 1 ;
                       ] ;
.

<#testResult>
    a                   sh:NodeShape ;
    sh:targetClass      sosa:Observation, sosa:Actuation, sosa:Sampling ;
    sh:targetSubjectsOf sosa:hasResult, sosa:hasSimpleResult ;
    # The result may also be given from the result's side (sosa:isResultOf, e.g. a Sample of a Sampling)
    sh:property         [
        sh:message          "Exactly one of sosa:hasResult, sosa:hasSimpleResult or sosa:isResultOf (from the result) is required per execution" ;
        sh:path     [ sh:alternativePath ( sosa:hasResult sosa:hasSimpleResult [ sh:inversePath sosa:isResultOf ] ) ] ;
                          sh:minCount 1 ;
                          sh:maxCount 1 ;
                  ] ;
.


<#testSimpleResultLiteral>
    a                  sh:NodeShape ;
    sh:targetObjectsOf sosa:hasSimpleResult ;
    sh:nodeKind        sh:IRIOrLiteral ;
    sh:message         "sosa:hasSimpleResult is a simple Literal" ;
.

## Shapes for collection requirements
# The SOSA collection consistency rules (see ExecutionCollection): where a collection has a
# property, each (direct or transitive) member's value for it must
#   - rules 2 and 3: be one of the collection's values;
#   - rules 4 and 5: where the collection's values include intervals, fall within one of them.
# A member that omits the property takes the collection's value (rule 2; see testRequiredTime).
# A time:Instant compares by its position, so it matches a literal time with the same value.

<#testCollectionPropertyValues>
    a sh:NodeShape ;
    sh:targetClass sosa:ObservationCollection, sosa:ActuationCollection, sosa:SamplingCollection ;
    sh:targetSubjectsOf sosa:hasMember ;
    sh:targetObjectsOf sosa:memberOf ;
    sh:message "Collection member values do not match those of the collections ({?path} property in {?value}: {?failedValue})";
    sh:sparql [ sh:select """
        PREFIX sosa: <http://www.w3.org/ns/sosa/>
        PREFIX geojson: <https://purl.org/geojson/vocab#>
        PREFIX time: <http://www.w3.org/2006/time#>
        PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
        SELECT $this ?path (?member AS ?value) ?failedValue WHERE {
            $this (sosa:hasMember|geojson:features|^sosa:memberOf)+ ?member .
            ?member ?path ?memberValue .
            FILTER(?path in ( sosa:resultTime, sosa:phenomenonTime, sosa:startTime, sosa:endTime,
                sosa:hasResult, sosa:hasSimpleResult,
                sosa:hasFeatureOfInterest, sosa:hasUltimateFeatureOfInterest, sosa:observedProperty, sosa:madeBySystem,
                sosa:usedProcedure, sosa:madeBySensor, sosa:madeBySampler, sosa:isSampleOf, sosa:madeByActuator,
                sosa:actsOn, sosa:actsOnProperty, sosa:hasInputValue, sosa:observationRelatedTo,
                sosa:relatedObservation, sosa:resultQuality, sosa:isOriginalSampleOf, sosa:isResultOfMadeBySampler,
                sosa:isResultOfUsedProcedure ))
            FILTER EXISTS { $this ?path ?anyValue }
            # interval values are checked by testCollectionPropertyValuesInterval
            FILTER NOT EXISTS { $this ?path ?interval . ?interval time:hasBeginning|time:hasEnd ?bound }
            # other embedded (blank node) values can't be compared
            FILTER NOT EXISTS {
                $this ?path ?embedded .
                FILTER(isBlank(?embedded))
                FILTER NOT EXISTS { ?embedded time:inXSDDateTime|time:inXSDDateTimeStamp|time:inXSDDate ?embeddedPosition }
            }
            OPTIONAL { ?memberValue time:inXSDDateTime|time:inXSDDateTimeStamp|time:inXSDDate ?memberPosition }
            BIND(COALESCE(?memberPosition, ?memberValue) AS ?mv0)
            FILTER(isIRI(?mv0) || isLiteral(?mv0))
            BIND(COALESCE(IF(DATATYPE(?mv0) = xsd:dateTimeStamp, xsd:dateTime(STR(?mv0)), ?mv0), ?mv0) AS ?mv)
            FILTER NOT EXISTS {
                $this ?path ?collectionValue .
                OPTIONAL { ?collectionValue time:inXSDDateTime|time:inXSDDateTimeStamp|time:inXSDDate ?collectionPosition }
                BIND(COALESCE(?collectionPosition, ?collectionValue) AS ?cv0)
                BIND(COALESCE(IF(DATATYPE(?cv0) = xsd:dateTimeStamp, xsd:dateTime(STR(?cv0)), ?cv0), ?cv0) AS ?cv)
                FILTER(sameTerm(?cv, ?mv) || COALESCE(?cv = ?mv, false))
            }
            BIND(CONCAT(STR(?mv), " is not one of the collection's values") AS ?failedValue)
        }
    """ ]
.

<#testCollectionPropertyValuesInterval>
    a sh:NodeShape ;
    sh:targetClass sosa:ObservationCollection, sosa:ActuationCollection, sosa:SamplingCollection ;
    sh:targetSubjectsOf sosa:hasMember ;
    sh:targetObjectsOf sosa:memberOf ;
    sh:message "Collection member values do not match those of the collections ({?path} property in {?value}: {?failedValue})";
    sh:sparql [ sh:select """
        PREFIX sosa: <http://www.w3.org/ns/sosa/>
        PREFIX geojson: <https://purl.org/geojson/vocab#>
        PREFIX time: <http://www.w3.org/2006/time#>
        PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
        SELECT $this ?path (?member AS ?value) ?failedValue WHERE {
            $this (sosa:hasMember|geojson:features|^sosa:memberOf)+ ?member .
            ?member ?path ?memberValue .
            FILTER(?path IN (sosa:phenomenonTime, sosa:resultTime, sosa:startTime, sosa:endTime))
            FILTER EXISTS { $this ?path ?interval . ?interval time:hasBeginning|time:hasEnd ?bound }
            # beginning and end of the member's value: a literal time, an Instant's position, or an
            # interval's bounds; an xsd:date covers the whole day
            OPTIONAL { ?memberValue time:hasBeginning?/(time:inXSDDateTime|time:inXSDDateTimeStamp|time:inXSDDate) ?mb0 }
            OPTIONAL { ?memberValue time:hasEnd?/(time:inXSDDateTime|time:inXSDDateTimeStamp|time:inXSDDate) ?me0 }
            BIND(IF(isLiteral(?memberValue), ?memberValue, ?mb0) AS ?mb1)
            BIND(IF(isLiteral(?memberValue), ?memberValue, ?me0) AS ?me1)
            BIND(IF(DATATYPE(?mb1) = xsd:date, xsd:dateTime(CONCAT(SUBSTR(STR(?mb1), 1, 10), "T00:00:00", SUBSTR(STR(?mb1), 11))), xsd:dateTime(STR(?mb1))) AS ?mb)
            BIND(IF(DATATYPE(?me1) = xsd:date, xsd:dateTime(CONCAT(SUBSTR(STR(?me1), 1, 10), "T23:59:59.999", SUBSTR(STR(?me1), 11))), xsd:dateTime(STR(?me1))) AS ?me)
            FILTER(BOUND(?mb) || BOUND(?me))
            # rule 5: it must fall within one of the collection's values (an interval, or equal to an
            # instant). A comparison that can't be decided (one time with a time zone and one without -
            # rdflib also drops the time zone of an xsd:date) doesn't count against it.
            FILTER NOT EXISTS {
                $this ?path ?collectionValue .
                OPTIONAL { ?collectionValue time:hasBeginning?/(time:inXSDDateTime|time:inXSDDateTimeStamp|time:inXSDDate) ?cb0 }
                OPTIONAL { ?collectionValue time:hasEnd?/(time:inXSDDateTime|time:inXSDDateTimeStamp|time:inXSDDate) ?ce0 }
                BIND(IF(isLiteral(?collectionValue), ?collectionValue, ?cb0) AS ?cb1)
                BIND(IF(isLiteral(?collectionValue), ?collectionValue, ?ce0) AS ?ce1)
                BIND(IF(DATATYPE(?cb1) = xsd:date, xsd:dateTime(CONCAT(SUBSTR(STR(?cb1), 1, 10), "T00:00:00", SUBSTR(STR(?cb1), 11))), xsd:dateTime(STR(?cb1))) AS ?cb)
                BIND(IF(DATATYPE(?ce1) = xsd:date, xsd:dateTime(CONCAT(SUBSTR(STR(?ce1), 1, 10), "T23:59:59.999", SUBSTR(STR(?ce1), 11))), xsd:dateTime(STR(?ce1))) AS ?ce)
                FILTER(BOUND(?cb) || BOUND(?ce))
                FILTER(COALESCE(!BOUND(?cb) || !BOUND(?mb) || (TZ(?mb) = "") != (TZ(?cb) = "") || ?mb >= ?cb, true)
                    && COALESCE(!BOUND(?ce) || !BOUND(?me) || (TZ(?me) = "") != (TZ(?ce) = "") || ?me <= ?ce, true))
            }
            BIND(CONCAT(COALESCE(STR(?mb), "?"), " .. ", COALESCE(STR(?me), "?"),
                " is not within any of the collection's values") AS ?failedValue)
        }
    """ ]
.
