@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix geojson: <https://purl.org/geojson/vocab#> .
@prefix sosa: <http://www.w3.org/ns/sosa/>.
@prefix : <urn:ogc-bblocks:ogcapi-sosa#> .

:FeatureAsObservation
  a sh:NodeShape ;
  sh:targetSubjectsOf
    sosa:hasResult
  ;
  # These properties may also be held in common at the ObservationCollection level
  # (sosa:hasMember / geojson:features), so only infer sosa:Observation when the
  # subject is not itself acting as a collection.
  sh:rule [
    a sh:SPARQLRule ;
    sh:prefixes [
      sh:declare [ sh:prefix "sosa" ; sh:namespace "http://www.w3.org/ns/sosa/"^^<http://www.w3.org/2001/XMLSchema#anyURI> ] ;
      sh:declare [ sh:prefix "geojson" ; sh:namespace "https://purl.org/geojson/vocab#"^^<http://www.w3.org/2001/XMLSchema#anyURI> ] ;
    ] ;
    sh:construct """
      CONSTRUCT { $this a sosa:Observation . }
      WHERE {
        FILTER NOT EXISTS { $this sosa:hasMember ?member . }
        FILTER NOT EXISTS { $this geojson:features ?feature . }
      }
    """ ;
  ] ;
.

:MemberOfObservationCollection
  a sh:NodeShape ;
  sh:targetObjectsOf
    sosa:isMemberOf
  ;
  sh:rule [
    a sh:TripleRule ;
    sh:subject sh:this ;
    sh:predicate rdf:type ;
    sh:object sosa:ObservationCollection ;
  ] ;
.

:FeatureCollectionAsObsCollection
  a sh:NodeShape ;
  sh:targetSubjectsOf sosa:hasMember
  ;
  sh:rule [
    a sh:TripleRule ;
    sh:subject sh:this ;
    sh:predicate rdf:type ;
    sh:object sosa:ObservationCollection ;
  ] ;
.